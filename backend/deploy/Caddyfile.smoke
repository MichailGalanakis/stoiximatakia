{
	admin off
}

skillbetting.test {
	tls internal
	@unpublished path /preview /preview/* /reference /reference/* /api/qa /api/qa/* /.git /.git/* /.env /.env.*
	respond @unpublished 404
	handle_path /api/* {
		reverse_proxy backend:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		reverse_proxy frontend:3000
	}
}

http://:8080 {
	respond /health "ok" 200
	respond 404
}
