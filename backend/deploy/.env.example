# Generate the real ignored deploy/.env with ./deploy/manage.sh init.
# Keep it outside release bundles and preserve these keys across updates.
SITE_HOST=dev.stoiximatakia.gr
APP_ORIGIN=https://dev.stoiximatakia.gr
RELEASE_ID=initial
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
APP_DATABASE_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
TABLE_CODE_SECRET=REPLACE_WITH_96_HEX_CHARACTERS
OTP_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
LOG_LEVEL=info
BACKUP_KEEP=14
BACKUP_INTERVAL_SECONDS=86400

# Delivery is disabled until real credentials and a verified sender are supplied.
RESEND_API_KEY=
RESEND_FROM=
SEVEN_API_KEY=
SEVEN_SENDER=SkillBet
