{
	admin off
}

{$SITE_HOST} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	@unpublished path /preview /preview/* /reference /reference/* /api/qa /api/qa/* /.git /.git/* /.env /.env.*
	respond @unpublished 404

	# Direct API + websocket transport: exactly one trusted hop to the backend.
	handle_path /api/* {
		reverse_proxy backend:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		reverse_proxy frontend:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}

# Internal container health only; this port is never published on the host.
http://:8080 {
	respond /health "ok" 200
	respond 404
}
