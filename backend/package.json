{
  "name": "skillbetting-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SkillBetting web backend foundation",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "prebuild": "npm run build:engines && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.local/database.env --env-file-if-exists=.env dist/main.js",
    "start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=.local/database.env --env-file-if-exists=.env dist/main.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest:compile": "npm run build:engines && node -e \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\"",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test \".test-dist/src/**/*.spec.js\" \".test-dist/test/**/*.e2e-spec.js\"",
    "test:unit": "npm run test:compile && node --test \".test-dist/src/**/*.spec.js\"",
    "test:e2e": "npm run test:compile && node --test \".test-dist/test/**/*.e2e-spec.js\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:chess && npm run test:cards && npm run build",
    "db:local:start": "node scripts/db-local.mjs start",
    "db:local:stop": "node scripts/db-local.mjs stop",
    "db:migrate": "node --env-file-if-exists=.local/database.env --env-file-if-exists=.env scripts/migrate.mjs",
    "test:integration": "npm run test:compile && node --env-file-if-exists=.local/database.env --test \".test-dist/test/**/*.integration-spec.js\"",
    "verification:secret": "node scripts/verification-secret.mjs",
    "test:chess": "npm --prefix engines/chess run check",
    "build:chess": "npm --prefix engines/chess run build",
    "build:engines": "npm run build:cards && npm run build:chess",
    "build:cards": "npm --prefix engines/xeri run build && npm --prefix engines/diloti run build && npm --prefix engines/rummy run build && npm --prefix engines/tichu run build",
    "pretypecheck": "npm run build:engines",
    "prestart:dev": "npm run build:engines",
    "test:cards": "npm --prefix engines/xeri run check && npm --prefix engines/diloti run check && npm --prefix engines/rummy run check && npm --prefix engines/tichu run check"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.6",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fastify": "5.12.7",
    "libphonenumber-js": "1.13.15",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.3.2",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "chess.js": "1.4.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tsc-watch": "7.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "imports": {
    "#engines/chess": "./engines/chess/dist/cjs/index.js",
    "#engines/xeri": "./engines/xeri/dist/cjs/index.js",
    "#engines/diloti": "./engines/diloti/dist/cjs/index.js",
    "#engines/rummy": "./engines/rummy/dist/cjs/index.js",
    "#engines/tichu": "./engines/tichu/dist/cjs/index.js"
  }
}
