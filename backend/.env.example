HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Keep 0 for native local development. The container backend is unpublished and
# uses 1 only behind the sole controlled edge proxy, which overwrites client XFF.
TRUST_PROXY_HOPS=0
# Browser origin, used for signup origin checks and Secure cookie selection.
APP_ORIGIN=http://127.0.0.1:3100
# Required when NODE_ENV=production. Local development uses npm run db:local:start.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/skillbetting

# Server-only verification delivery. Initial sends happen when step 2 opens.
# Put real keys only in the ignored backend .env, never frontend NEXT_PUBLIC_*.
RESEND_API_KEY=
RESEND_FROM="SkillBetting <onboarding@resend.dev>"
SEVEN_API_KEY=
SEVEN_SENDER=SkillBet
# Generate locally with npm run verification:secret. Keep this high-entropy key stable.
OTP_SECRET=

# Stable server-only key (at least 32 bytes) for private table code lookup.
# Required when NODE_ENV=production. Keep it stable across deploys/restarts.
# In local development public tables work without it; private tables require it.
TABLE_CODE_SECRET=
